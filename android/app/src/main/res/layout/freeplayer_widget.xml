<?xml version="1.0" encoding="utf-8"?>
<!-- Widget de Free Player (horizontal, estilo de la captura de referencia):
       - carátula de la canción ocupando TODO el fondo (recortada)
       - degradado oscuro abajo para que el texto se lea siempre
       - título (hasta 2 líneas) y artista centrados
       - fila de 3 botones planos: ⏮ / ▶·⏸ / ⏭
     RemoteViews solo admite vistas "seguras": FrameLayout, LinearLayout,
     ImageView, TextView e ImageButton (todas usadas aquí). -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/fp_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/fp_widget_art_bg">

    <!-- Carátula a pantalla completa del widget -->
    <ImageView
        android:id="@+id/fp_art"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/fp_widget_art_bg"
        android:contentDescription="@string/fp_widget_label"
        android:scaleType="centerCrop" />

    <!-- Oscurecido inferior: se usa un ImageView porque RemoteViews no
         admite la clase View genérica -->
    <ImageView
        android:id="@+id/fp_scrim"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:importantForAccessibility="no"
        android:scaleType="fitXY"
        android:src="@drawable/fp_widget_scrim" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:orientation="vertical"
        android:paddingLeft="14dp"
        android:paddingTop="10dp"
        android:paddingRight="14dp"
        android:paddingBottom="10dp">

        <TextView
            android:id="@+id/fp_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:gravity="center_horizontal"
            android:maxLines="2"
            android:shadowColor="#CC000000"
            android:shadowRadius="6"
            android:textColor="@color/fp_widget_text"
            android:textSize="15sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/fp_artist"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="1dp"
            android:ellipsize="end"
            android:gravity="center_horizontal"
            android:maxLines="1"
            android:shadowColor="#CC000000"
            android:shadowRadius="6"
            android:textColor="@color/fp_widget_text_secondary"
            android:textSize="12sp" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:gravity="center"
            android:orientation="horizontal">

            <ImageButton
                android:id="@+id/fp_prev"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="@android:color/transparent"
                android:contentDescription="@string/fp_desc_prev"
                android:padding="8dp"
                android:scaleType="fitCenter"
                android:src="@drawable/fp_ic_prev" />

            <ImageButton
                android:id="@+id/fp_play"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_marginLeft="18dp"
                android:layout_marginRight="18dp"
                android:background="@android:color/transparent"
                android:contentDescription="@string/fp_desc_play"
                android:padding="7dp"
                android:scaleType="fitCenter"
                android:src="@drawable/fp_ic_play" />

            <ImageButton
                android:id="@+id/fp_next"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="@android:color/transparent"
                android:contentDescription="@string/fp_desc_next"
                android:padding="8dp"
                android:scaleType="fitCenter"
                android:src="@drawable/fp_ic_next" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
